# ==== LOCAL DEMO ====
PORT=3000
INSIGHTLOOP_DB_PATH=

# ==== ADMIN ACCESS ====
# Set a long, unique secret in the server/Vercel environment settings.
# Never commit the real password or expose it in frontend JavaScript.
INSIGHTLOOP_ADMIN_PASSWORD=

# ==== FUTURE AI INTEGRATION ====
# Optional future server-side provider settings. Do not add secrets to public/ files.
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=

# ==== PRODUCTION DATABASE ====
# These placeholders are not consumed by the current SQLite demo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ==== PAYMENTS (NOT INTEGRATED) ====
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
UPI_PAYOUT_PROVIDER_KEY=

# ==== SESSION / SECURITY ====
SESSION_SIGNING_SECRET=

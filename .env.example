# ==== LOCAL DEMO (works out of the box, no external services needed) ====
PORT=3000
# Path to the local SQLite demo database. Leave unset to use the default
# (data/insightloop.db). Set to ":memory:" for an ephemeral in-memory DB.
INSIGHTLOOP_DB_PATH=

# ==== PRODUCTION DATABASE STATUS ====
# The Node HTTP server currently uses SQLite only for local/demo use.
# Vercel startup intentionally fails until a durable PostgreSQL adapter is
# implemented and verified. These are placeholders, NOT active configuration.
# Never use /tmp or the deployment filesystem as durable database storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# If a PostgreSQL adapter is added, prefer a server-side DATABASE_URL (secret).
# DATABASE_URL=

# ==== PAYMENTS (NOT INTEGRATED — see README "What is still mocked/manual") ====
# Business payments and participant payouts are entirely manual/ledger-only
# in P0. These are placeholders for the real integration, not active config.
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
UPI_PAYOUT_PROVIDER_KEY=

# ==== SESSION / SECURITY ====
# The demo uses random per-server-restart session tokens generated by
# node:crypto and stored server-side in the `sessions` table — there is no
# separate secret to configure. If you add JWT-based sessions later, put
# the signing secret here and NEVER commit a real value.
SESSION_SIGNING_SECRET=

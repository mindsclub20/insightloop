# Copy to mobile/.env and fill in from your Supabase project's Settings > API page.
# Both of these are PUBLIC values (the anon key, not the service role key) -
# they end up compiled into the app bundle/APK, which is expected and safe
# because RLS is the actual security boundary, not secrecy of this key.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in this file or anywhere under mobile/.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
